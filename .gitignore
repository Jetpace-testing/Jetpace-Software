# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# build output
build/
dist/
*.spec

# vendored third-party payloads - fetched by script, never committed
installer/vendor/

# local secrets and config
.env
*.key

# dev-only: database, logs, generated passwords
.local/

# The manufacturer datasheets used to sit here, ignored, and were moved
# out on 19 October 2026: they are the instrument range's documentation,
# not this project's source. The ignore rule went with them DELIBERATELY.
# If the folder ever reappears here, git status should say so - that is a
# useful signal that 110 MB of PDFs are back in the wrong repository,
# which an ignore rule would hide. docs/instruments.md says where they are
# and how a transcription records which document it came from.

# Per-developer Claude Code permissions, not project configuration.
.claude/settings.local.json

# Written by scripts/register_supervisor_service.py; absolute paths, per machine.
/supervisor.json

# Build output: frozen bundles and release payloads, rebuilt by scripts/build.py.
/dist/
/build/
